# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Models
ORCHESTRATOR_MODEL=gemini-flash-latest
DOM_SUBAGENT_MODEL=gemini-flash-latest

# Browser Settings
HEADLESS=false
USER_DATA_DIR=./.browser_profile
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# Rate limit pacing
STEP_COOLDOWN_MS=2500
